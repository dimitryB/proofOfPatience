# Local Worker configuration. Never put production keys in a committed file.
HEMI_RPC_URL=https://rpc.hemi.network/rpc

# Optional, comma separated. Hemi's public RPC is documented at roughly 300
# requests a minute and described as being for development, so production should
# name at least one fallback (dRPC, Infura and QuickNode all support Hemi).
HEMI_RPC_FALLBACKS=

POP_CONTRACT_ADDRESS=
POP_VERIFIER_PRIVATE_KEY=

# Block the contract was deployed in. Setting this switches the leaderboard from
# scanning the contract's player arrays to reading logs, which removes the
# ceiling on how many players the board can show. The Sites project provisions
# the required D1 `DB` binding from .openai/hosting.json; without DB the Worker
# falls back to the bounded contract scan.
POP_DEPLOY_BLOCK=

# Turnstile bot protection for /api/chain/attest. Set BOTH together or neither:
# the secret verifies tokens server-side, the site key is delivered to the game
# so it can fetch one. Setting only the secret would reject every submission.
POP_TURNSTILE_SECRET=
POP_TURNSTILE_SITE_KEY=
